diff --git a/src/libcamera/info_frame.cpp b/src/libcamera/info_frame.cpp
index 75d7f60..f5e8d22 100644
--- a/src/libcamera/info_frame.cpp
+++ b/src/libcamera/info_frame.cpp
@@ -193,6 +193,41 @@ int InfoFramePool::createBuffers(DmaHeap *dmaHeap,
 	return setBuffers(format, size, buffers, strideAlign, scanAlign);
 }

+int InfoFramePool::createSeparatePlaneBuffers(DmaHeap *dmaHeap,
+					    const PixelFormat &format, const Size &size,
+					    unsigned int count, DmaHeap::Type type,
+					    unsigned int strideAlign, unsigned scanAlign)
+{
+	release();
+	const PixelFormatInfo &info = PixelFormatInfo::info(format);
+
+	/* Keep createBuffers() and its contiguous CAMSYS layout unchanged.
+	 * Each ImgSys plane starts at its own FD's base: CAPTURE QBUF drops
+	 * userspace data_offset, so an offset into a shared FD cannot work.
+	 */
+	std::vector<std::unique_ptr<FrameBuffer>> buffers;
+	buffers.reserve(count);
+	for (unsigned int i = 0; i < count; i++) {
+		std::vector<FrameBuffer::Plane> planes;
+		planes.reserve(info.numPlanes());
+		for (unsigned int j = 0; j < info.numPlanes(); j++) {
+			FrameBuffer::Plane plane;
+			plane.length = info.planeSize(size, j, strideAlign, scanAlign);
+			SharedFD fd(dmaHeap->alloc(plane.length, type));
+			if (!fd.isValid())
+				return -EBUSY; /* Local vectors release every partial allocation. */
+
+			plane.fd = fd;
+			plane.offset = 0;
+			plane.stride = info.stride(size.width, j, strideAlign);
+			planes.emplace_back(plane);
+		}
+		buffers.emplace_back(std::make_unique<FrameBuffer>(planes));
+	}
+
+	return setBuffers(format, size, buffers, strideAlign, scanAlign);
+}
+
 int LazyInfoFramePool::setFormat(DmaHeap *dmaHeap, const PixelFormat &format,
 				 const Size &size,
 				 DmaHeap::Type type,
